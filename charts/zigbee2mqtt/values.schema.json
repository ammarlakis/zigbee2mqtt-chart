{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "zigbee2mqtt": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "imagePullSecrets": {
          "type": "array"
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "annotations": {
              "type": "object"
            },
            "name": {
              "type": "string"
            },
            "automount": {
              "type": "boolean"
            }
          }
        },
        "podLabels": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "env": {
          "type": "array"
        },
        "envFrom": {
          "type": "array"
        },
        "livenessProbe": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        },
        "startupProbe": {
          "type": "object"
        },
        "updateStrategy": {
          "type": "object"
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object"
            }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["host", "paths"],
                "properties": {
                  "host": {
                    "type": "string",
                    "minLength": 1
                  },
                  "paths": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "pathType": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "tls": {
              "type": "array"
            }
          },
          "if": {
            "required": ["enabled"],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "hosts": {
                "minItems": 1
              }
            }
          }
        },
        "timezone": {
          "type": "string"
        },
        "zigbee_device": {
          "type": "string"
        },
        "device": {
          "type": "object",
          "properties": {
            "hostPath": {
              "type": "string"
            },
            "mountPath": {
              "type": "string",
              "minLength": 1
            },
            "hostPathType": {
              "type": "string"
            }
          }
        },
        "udev": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "hostPath": {
              "type": "string",
              "minLength": 1
            },
            "mountPath": {
              "type": "string",
              "minLength": 1
            },
            "hostPathType": {
              "type": "string"
            },
            "readOnly": {
              "type": "boolean"
            }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingClaim": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClassName": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "labels": {
              "type": "object"
            }
          }
        },
        "existingConfigSecret": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "overwriteConfig": {
          "type": "boolean"
        },
        "initConfig": {
          "type": "object"
        },
        "extraVolumeMounts": {
          "type": "array"
        },
        "extraVolumes": {
          "type": "array"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        }
      }
    }
  }
}
